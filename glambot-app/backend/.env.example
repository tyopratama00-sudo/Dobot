# Contoh backend/.env — salin ke .env lalu isi. Penjelasan lengkap tiap
# variabel ada di README (section Konfigurasi Environment).

# Server
APP_PORT=8080
APP_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/photobooth?sslmode=disable

# Midtrans (opsional, untuk QRIS payment)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox

# Storage
STORAGE_PATH=./storage

# digiCamControl HTTP API (untuk Canon)
DIGICAM_BASE_URL=http://localhost:5513/api

# Session
PAYMENT_EXPIRY_MINS=2
SESSION_EXPIRY_HOURS=72
CLEANUP_INTERVAL_HOURS=24

# CORS allowed origin
FRONTEND_URL=http://localhost:5173

# Robot integration (opsional)
ROBOT_API_URL=
ROBOT_ENABLED=false

# Admin dashboard auth — WAJIB diganti di production.
JWT_SECRET=ganti-dengan-secret-acak-panjang
ADMIN_EMAIL=admin@glambot.com
ADMIN_PASSWORD=admin123

# Google Drive upload (opsional). Kosongkan untuk menonaktifkan.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Email booth lewat Gmail (opsional) — untuk Email Foto & email uji di admin.
# Email aktif hanya kalau SMTP_USER DAN SMTP_APP_PASSWORD terisi.
# SMTP_APP_PASSWORD = App Password Google (16 huruf), BUKAN password Gmail biasa.
# App Password hanya bisa dibuat kalau akun Gmail sudah mengaktifkan
# 2-Step Verification: https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_APP_PASSWORD=
# Opsional: bawaan smtp.gmail.com port 587 (STARTTLS). Port 465 = TLS langsung.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Opsional: nama pengirim Email Foto. Kosong = brand label di Pengaturan admin,
# atau "Glambot Photo Booth". Subjek, isi email, dan pesan WhatsApp selalu
# memakai brand label (atau "Glambot Photo Booth").
SMTP_FROM_NAME=Glambot Photo Booth
